---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MasonryGrid from "../../components/MasonryGrid.astro";
import GalleryCard from "../../components/GalleryCard.astro";
import Lightbox from "../../components/Lightbox.astro";
import { getCollection } from "astro:content";
import categoriesData from "../../data/categories.json";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  return categoriesData.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: (typeof categoriesData)[number];
}

const { category } = Astro.props;
const allEntries = await getCollection("galleries");
const entries = allEntries
  .filter((entry) => entry.data.category === category.slug)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={category.label}
  description={`${category.label} photography gallery.`}
>
  <section class="container gallery-page">
    <h1>{category.label}</h1>
    {
      category.slug === "portraits" && (
        <a class="gallery-page__promo" href={withBase("/team-headshots/")}>
          Need headshots for your whole team? See on-site team sessions
          <span aria-hidden="true">→</span>
        </a>
      )
    }
    <MasonryGrid>
      {
        entries.map((entry, i) => <GalleryCard entry={entry} index={i} />)
      }
    </MasonryGrid>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .gallery-page {
    padding-block: var(--space-4) var(--space-6);
  }

  .gallery-page h1 {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .gallery-page__promo {
    display: block;
    margin-bottom: var(--space-3);
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    font-size: 0.95rem;
    transition: border-color 0.15s ease;
  }

  .gallery-page__promo:hover {
    border-color: var(--color-accent);
  }

  .gallery-page__promo span {
    color: var(--color-accent);
  }
</style>
