---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MasonryGrid from "../../components/MasonryGrid.astro";
import GalleryCard from "../../components/GalleryCard.astro";
import Lightbox from "../../components/Lightbox.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import categoriesData from "../../data/categories.json";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  return categoriesData.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: (typeof categoriesData)[number];
}

const { category } = Astro.props;
const allEntries = await getCollection("galleries");
const entries = allEntries
  .filter((entry) => entry.data.category === category.slug)
  .sort((a, b) => a.data.order - b.data.order);

// A small teaser stack for the team-headshots promo below, reusing the
// same matched set team-headshots.astro leads with — just enough to
// hint at "a team, matched" without duplicating that page's full grid.
const promoFaces =
  category.slug === "portraits"
    ? [1, 2, 3]
        .map((order) => entries.find((entry) => entry.data.order === order))
        .filter((entry) => entry !== undefined)
    : [];
---

<BaseLayout
  title={category.label}
  description={`${category.label} photography gallery.`}
>
  <section class="container gallery-page">
    <h1>{category.label}</h1>
    {
      category.slug === "portraits" && (
        <a class="gallery-page__promo" href={withBase("/team-headshots/")}>
          <ul class="gallery-page__promo-faces" aria-hidden="true">
            {promoFaces.map((entry) => (
              <li>
                <Image src={entry.data.image!} alt="" width={96} />
              </li>
            ))}
          </ul>
          <div class="gallery-page__promo-copy">
            <p class="gallery-page__promo-eyebrow">On-site team sessions</p>
            <p class="gallery-page__promo-headline">
              Need headshots for your whole team?
            </p>
          </div>
          <span class="gallery-page__promo-cta">
            See how it works<span aria-hidden="true"> →</span>
          </span>
        </a>
      )
    }
    <MasonryGrid>
      {
        entries.map((entry, i) => <GalleryCard entry={entry} index={i} />)
      }
    </MasonryGrid>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .gallery-page {
    padding-block: var(--space-4) var(--space-6);
  }

  .gallery-page h1 {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .gallery-page__promo {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-4);
    padding: var(--space-3);
    background: var(--color-border);
    border-left: 3px solid var(--color-accent);
    transition: background 0.15s ease;
  }

  .gallery-page__promo:hover {
    background: color-mix(in srgb, var(--color-border), var(--color-text) 8%);
  }

  .gallery-page__promo-faces {
    display: flex;
    flex-shrink: 0;
  }

  .gallery-page__promo-faces li {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-border);
    margin-left: -0.75rem;
  }

  .gallery-page__promo-faces li:first-child {
    margin-left: 0;
  }

  .gallery-page__promo-faces :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-page__promo-copy {
    flex: 1 1 260px;
  }

  .gallery-page__promo-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.15rem;
  }

  .gallery-page__promo-headline {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: 0.01em;
  }

  .gallery-page__promo-cta {
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
    color: var(--color-accent);
    white-space: nowrap;
  }
</style>
