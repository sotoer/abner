---
import BaseLayout from "../layouts/BaseLayout.astro";
import MasonryGrid from "../components/MasonryGrid.astro";
import MosaicTile from "../components/MosaicTile.astro";
import Lightbox from "../components/Lightbox.astro";
import { getCollection } from "astro:content";
import { getCategoryCards } from "../lib/categoryCards";
import { toSlide, toThumb } from "../lib/galleryMedia";
import { withBase } from "../lib/url";

const allEntries = await getCollection("galleries");
const categoryCards = getCategoryCards(allEntries);

// Every category's full gallery, for the lightbox. A mosaic tile isn't
// tied to one category — its cycling can swap in any category's photo
// (see MosaicTile's client script) — so every tile needs access to
// every category's slides, not just whichever one it started on. This
// map is embedded once on the container below, rather than once per
// tile, since every tile would otherwise repeat the same ~4 arrays.
const slidesBySlug: Record<string, Awaited<ReturnType<typeof toSlide>>[]> = {};
for (const category of categoryCards) {
  slidesBySlug[category.slug] = await Promise.all(category.entries.map(toSlide));
}
const slidesBySlugJson = JSON.stringify(slidesBySlug);

// One combined thumbnail pool spanning every category, each tagged with
// which category (and its label) it belongs to — the pool the mosaic's
// cycling script draws from client-side, embedded once on the container
// for the same reason as slidesBySlug above.
const categoryThumbs = await Promise.all(
  categoryCards.map(async (category) => {
    const thumbs = await Promise.all(
      category.entries.map((entry) => toThumb(entry, 700)),
    );
    return {
      category,
      // index is this thumb's position in the category's own slides
      // array (built in the same order above), so a click can open the
      // lightbox on the exact photo/video the tile is showing — same as
      // clicking a photo on /work/[category] — rather than always at 0.
      thumbs: thumbs.map((thumb, index) => ({
        ...thumb,
        category: category.slug,
        categoryLabel: category.label,
        index,
      })),
    };
  }),
);
const allThumbsJson = JSON.stringify(categoryThumbs.flatMap((c) => c.thumbs));

// A fixed number of tiles, seeded round-robin across categories so the
// mosaic starts out mixed even before client JS randomizes it further
// (and keeps cycling it across every category from then on).
const TILE_COUNT = 12;
const tileSeeds = Array.from({ length: TILE_COUNT }, (_, i) => {
  const { category, thumbs } = categoryThumbs[i % categoryThumbs.length];
  const round = Math.floor(i / categoryThumbs.length);
  return {
    thumb: thumbs[round % thumbs.length],
    categoryLabel: category.label,
    initialSlidesJson: JSON.stringify(slidesBySlug[category.slug]),
  };
});
---

<BaseLayout
  title="Abner Soto Multimedia Producer"
  description="Trusted by leading brands to produce, shoot, and edit content that delivers."
>
  <section class="hero container">
    <h1>Abner Soto Multimedia Producer</h1>
    <p class="hero__tagline">
      Trusted by leading brands to produce, shoot, and edit content that
      delivers
    </p>
    <a href={withBase("/work")} class="hero__cta">View the work &rarr;</a>
  </section>

  <section class="featured container">
    <h2>Featured work</h2>
    <MasonryGrid data-mosaic-pool={allThumbsJson} data-mosaic-slides={slidesBySlugJson}>
      {
        tileSeeds.map((seed) => (
          <MosaicTile
            thumbSrc={seed.thumb.src}
            thumbAlt={seed.thumb.alt}
            width={seed.thumb.width}
            height={seed.thumb.height}
            categoryLabel={seed.categoryLabel}
            initialSlidesJson={seed.initialSlidesJson}
            initialSlideIndex={seed.thumb.index}
          />
        ))
      }
    </MasonryGrid>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6);
    max-width: 700px;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: 0.02em;
  }

  .hero__tagline {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .hero__cta {
    display: inline-block;
    margin-top: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    color: var(--color-accent);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .featured {
    padding-bottom: var(--space-6);
  }

  .featured h2 {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
</style>
