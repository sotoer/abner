---
import BaseLayout from "../layouts/BaseLayout.astro";
import MasonryGrid from "../components/MasonryGrid.astro";
import MosaicTile from "../components/MosaicTile.astro";
import Lightbox from "../components/Lightbox.astro";
import { getCollection } from "astro:content";
import { getCategoryCards } from "../lib/categoryCards";
import { toSlide, toThumb } from "../lib/galleryMedia";
import { withBase } from "../lib/url";

const allEntries = await getCollection("galleries");
const categoryCards = getCategoryCards(allEntries);

// Every category's full gallery, for the lightbox. A mosaic tile isn't
// tied to one category — its cycling can swap in any category's photo
// (see MosaicTile's client script) — so every tile needs access to
// every category's slides, not just whichever one it started on. This
// map is embedded once on the container below, rather than once per
// tile, since every tile would otherwise repeat the same ~4 arrays.
const slidesBySlug: Record<string, Awaited<ReturnType<typeof toSlide>>[]> = {};
for (const category of categoryCards) {
  slidesBySlug[category.slug] = await Promise.all(category.entries.map(toSlide));
}
const slidesBySlugJson = JSON.stringify(slidesBySlug);

// One combined thumbnail pool spanning every category, each tagged with
// which category (and its label) it belongs to — the pool the mosaic's
// cycling script draws from client-side, embedded once on the container
// for the same reason as slidesBySlug above.
const categoryThumbs = await Promise.all(
  categoryCards.map(async (category) => {
    const thumbs = await Promise.all(
      category.entries.map((entry) => toThumb(entry, 700)),
    );
    return {
      category,
      // index is this thumb's position in the category's own slides
      // array (built in the same order above), so a click can open the
      // lightbox on the exact photo/video the tile is showing — same as
      // clicking a photo on /work/[category] — rather than always at 0.
      thumbs: thumbs.map((thumb, index) => ({
        ...thumb,
        category: category.slug,
        categoryLabel: category.label,
        index,
      })),
    };
  }),
);
const allThumbsJson = JSON.stringify(categoryThumbs.flatMap((c) => c.thumbs));

// A fixed number of tiles, seeded round-robin across categories so the
// mosaic starts out mixed even before client JS randomizes it further
// (and keeps cycling it across every category from then on).
const TILE_COUNT = 12;
const tileSeeds = Array.from({ length: TILE_COUNT }, (_, i) => {
  const { category, thumbs } = categoryThumbs[i % categoryThumbs.length];
  const round = Math.floor(i / categoryThumbs.length);
  return {
    thumb: thumbs[round % thumbs.length],
    categoryLabel: category.label,
    initialSlidesJson: JSON.stringify(slidesBySlug[category.slug]),
  };
});
---

<BaseLayout
  title="Abner Soto Multimedia Producer"
  description="Trusted by leading brands to produce, shoot, and edit content that delivers."
>
  <section class="hero-banner">
    <canvas
      class="hero-banner__canvas"
      id="hero-kinetic-bg"
      aria-hidden="true"
    ></canvas>
    <div class="hero container">
      <h1>Abner Soto Multimedia Producer</h1>
      <p class="hero__tagline">
        Trusted by leading brands to produce, shoot, and edit content that
        delivers
      </p>
      <a href={withBase("/work")} class="hero__cta">View the work &rarr;</a>
    </div>
  </section>

  <section class="featured container">
    <MasonryGrid data-mosaic-pool={allThumbsJson} data-mosaic-slides={slidesBySlugJson}>
      {
        tileSeeds.map((seed) => (
          <MosaicTile
            thumbSrc={seed.thumb.src}
            thumbAlt={seed.thumb.alt}
            width={seed.thumb.width}
            height={seed.thumb.height}
            categoryLabel={seed.categoryLabel}
            initialSlidesJson={seed.initialSlidesJson}
            initialSlideIndex={seed.thumb.index}
          />
        ))
      }
    </MasonryGrid>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .hero-banner {
    position: relative;
    overflow: hidden;
  }

  .hero-banner__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  .hero {
    position: relative;
    padding-block: var(--space-6);
    max-width: 700px;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    letter-spacing: 0.04em;
    line-height: 0.95;
  }

  .hero__tagline {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .hero__cta {
    display: inline-block;
    margin-top: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    color: var(--color-accent);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .featured {
    padding-bottom: var(--space-6);
  }
</style>

<script>
  interface Circle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
    lineWidth: number;
    opacity: number;
    // 0 draws a plain circle outline; 3+ draws a regular polygon (that
    // many sides) inscribed in the same radius instead, for a more
    // angular, faceted look mixed in among the circles.
    sides: number;
    rotation: number;
    rotationSpeed: number;
  }

  function initHeroKineticBackground() {
    const canvasRaw = document.getElementById("hero-kinetic-bg");
    if (!(canvasRaw instanceof HTMLCanvasElement)) return;
    const canvas: HTMLCanvasElement = canvasRaw;
    const banner = canvas.closest<HTMLElement>(".hero-banner");
    const ctx = canvas.getContext("2d");
    if (!banner || !ctx) return;

    const LINE_DISTANCE = 170;
    // Near-black (--color-text) rather than the warm terracotta accent —
    // a cooler, higher-contrast ink tone reads more technical/edgy than
    // the friendlier warm hue.
    const SHAPE_COLOR = "26, 26, 26";
    const LINE_COLOR = "26, 26, 26";

    let width = 0;
    let height = 0;
    let circles: Circle[] = [];

    function seedCircles() {
      const count = Math.max(6, Math.round((width * height) / 65000));
      circles = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.45,
        vy: (Math.random() - 0.5) * 0.45,
        r: 18 + Math.random() * 46,
        // Varying these per circle (hairline/faint vs. bold/solid) is what
        // reads as a technical schematic rather than uniform, cartoonish
        // bubbles — mimics different "layers" of emphasis on a diagram.
        lineWidth: 0.5 + Math.random() * 2,
        opacity: 0.05 + Math.random() * 0.12, // max stays below the 0.175 flat value set earlier
        // Roughly a third of shapes are angular polygons (3-6 sides)
        // mixed in among the circles, for a more faceted, less bubbly look.
        sides: Math.random() < 0.35 ? 3 + Math.floor(Math.random() * 4) : 0,
        rotation: Math.random() * Math.PI * 2,
        rotationSpeed: (Math.random() - 0.5) * 0.01,
      }));
    }

    function resize() {
      const rect = banner!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      seedCircles();
    }

    // Equal-mass elastic collision: swap the velocity component along the
    // line connecting the two centers, leave the perpendicular component
    // untouched — this is what makes the lines between circles feel
    // "kinetic" rather than just decorative, since their length and
    // opacity keep shifting as circles actually bounce off each other.
    function resolveCollision(a: Circle, b: Circle) {
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dist = Math.hypot(dx, dy) || 0.0001;
      const minDist = a.r + b.r;
      if (dist >= minDist) return;

      const nx = dx / dist;
      const ny = dy / dist;
      const overlap = (minDist - dist) / 2;
      a.x -= nx * overlap;
      a.y -= ny * overlap;
      b.x += nx * overlap;
      b.y += ny * overlap;

      const aN = a.vx * nx + a.vy * ny;
      const bN = b.vx * nx + b.vy * ny;
      a.vx += (bN - aN) * nx;
      a.vy += (bN - aN) * ny;
      b.vx += (aN - bN) * nx;
      b.vy += (aN - bN) * ny;
    }

    function step() {
      for (const c of circles) {
        c.x += c.vx;
        c.y += c.vy;
        c.rotation += c.rotationSpeed;
        if (c.x - c.r < 0) {
          c.x = c.r;
          c.vx = Math.abs(c.vx);
        } else if (c.x + c.r > width) {
          c.x = width - c.r;
          c.vx = -Math.abs(c.vx);
        }
        if (c.y - c.r < 0) {
          c.y = c.r;
          c.vy = Math.abs(c.vy);
        } else if (c.y + c.r > height) {
          c.y = height - c.r;
          c.vy = -Math.abs(c.vy);
        }
      }
      for (let i = 0; i < circles.length; i++) {
        for (let j = i + 1; j < circles.length; j++) {
          resolveCollision(circles[i], circles[j]);
        }
      }
    }

    function draw() {
      ctx!.clearRect(0, 0, width, height);

      for (let i = 0; i < circles.length; i++) {
        for (let j = i + 1; j < circles.length; j++) {
          const a = circles[i];
          const b = circles[j];
          const dist = Math.hypot(b.x - a.x, b.y - a.y);
          if (dist >= LINE_DISTANCE) continue;
          const alpha = 0.198 * (1 - dist / LINE_DISTANCE);
          ctx!.strokeStyle = `rgba(${LINE_COLOR}, ${alpha})`;
          ctx!.lineWidth = 1;
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          ctx!.lineTo(b.x, b.y);
          ctx!.stroke();
        }
      }

      for (const c of circles) {
        ctx!.strokeStyle = `rgba(${SHAPE_COLOR}, ${c.opacity})`;
        ctx!.lineWidth = c.lineWidth;
        ctx!.beginPath();
        if (c.sides === 0) {
          ctx!.arc(c.x, c.y, c.r, 0, Math.PI * 2);
        } else {
          for (let i = 0; i < c.sides; i++) {
            const angle = c.rotation + (i / c.sides) * Math.PI * 2;
            const px = c.x + Math.cos(angle) * c.r;
            const py = c.y + Math.sin(angle) * c.r;
            i === 0 ? ctx!.moveTo(px, py) : ctx!.lineTo(px, py);
          }
          ctx!.closePath();
        }
        ctx!.stroke();
      }
    }

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let frameId = 0;
    function loop() {
      step();
      draw();
      frameId = requestAnimationFrame(loop);
    }

    resize();
    draw();
    if (!reducedMotion) {
      frameId = requestAnimationFrame(loop);
    }

    let resizeTimeout = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        resize();
        draw();
      }, 150);
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        cancelAnimationFrame(frameId);
      } else if (!reducedMotion) {
        frameId = requestAnimationFrame(loop);
      }
    });
  }

  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", initHeroKineticBackground)
    : initHeroKineticBackground();
</script>
