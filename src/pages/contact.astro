---
import BaseLayout from "../layouts/BaseLayout.astro";

// Set PUBLIC_RECAPTCHA_SITE_KEY (see .env.example) to turn on the
// reCAPTCHA widget below. Left unset, the form just renders without it
// (still protected by the honeypot alone) rather than shipping a widget
// pointed at a fake key, which Google would render as a visible error
// for every visitor.
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<BaseLayout title="Contact" description="Get in touch — placeholder contact form.">
  <section class="container contact">
    <h1>Contact</h1>
    <p>
      Thank you for your interest in working together. Please share a few
      details about your project below, and I will follow up promptly to
      discuss how we might collaborate.
    </p>

    <!-- TODO: wire this form to Netlify Forms or Formspree once a backend is chosen.
         Whichever it is: have it reject a submission where the honeypot field
         below is non-empty, and — once PUBLIC_RECAPTCHA_SITE_KEY is set — verify
         the g-recaptcha-response token server-side with the matching SECRET key
         via https://www.google.com/recaptcha/api/siteverify. Both JS guards here
         only stop bots that execute page scripts; one posting straight to the
         endpoint skips them entirely, so the real checks have to happen
         server-side. -->
    <form
      class="contact__form"
      action="#"
      method="post"
      data-recaptcha-site-key={recaptchaSiteKey}
    >
      <label>
        Name
        <input type="text" name="name" required />
      </label>
      <label>
        Email
        <input type="email" name="email" required />
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required></textarea>
      </label>
      <!-- Honeypot: hidden from sighted users (off-screen) and screen
           readers (aria-hidden + removed from tab order), but present in
           the raw HTML for simple bots that fill in every field to find
           and fill. A human never sees or reaches it, so any submission
           with this non-empty is spam. -->
      <label class="contact__hp" aria-hidden="true">
        Company
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
      {
        recaptchaSiteKey && (
          <input type="hidden" name="g-recaptcha-response" />
        )
      }
      <button type="submit">Send</button>
    </form>
  </section>

  {
    recaptchaSiteKey && (
      <script
        is:inline
        src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}
        async
        defer
      />
    )
  }
</BaseLayout>

<style>
  .contact {
    padding-block: var(--space-5);
    max-width: 560px;
  }

  .contact h1 {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .contact__form {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .contact__form label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .contact__form input,
  .contact__form textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: #fff;
    color: var(--color-text);
  }

  .contact__form button {
    justify-self: start;
    margin-top: var(--space-1);
    padding: 0.6rem 1.5rem;
    border: 1px solid var(--color-text);
    background: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .contact__form button:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  /* Off-screen rather than display:none/visibility:hidden — some spam
     bots specifically skip fields hidden that way, which would defeat
     the honeypot. This must NOT reuse a generic .visually-hidden
     utility: that pattern intentionally stays in the accessibility
     tree for screen readers, which would expose this field to (and
     risk being filled in by) real assistive-tech users. */
  .contact__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  declare const grecaptcha:
    | {
        ready(callback: () => void): void;
        execute(siteKey: string, options: { action: string }): Promise<string>;
      }
    | undefined;

  const form = document.querySelector<HTMLFormElement>(".contact__form");
  const honeypot = form?.querySelector<HTMLInputElement>('[name="company"]');
  const siteKey = form?.dataset.recaptchaSiteKey;
  const tokenField =
    form?.querySelector<HTMLInputElement>('[name="g-recaptcha-response"]');

  // v3 is invisible — no checkbox to complete, just a token fetched right
  // before submit — so once it's attached this flag lets the resubmit
  // through instead of re-fetching a token forever.
  let hasToken = false;

  form?.addEventListener("submit", (e) => {
    // A human never sees or fills this field, so a non-empty value means
    // a bot filled in every input it could find — silently drop the
    // submission. Only stops bots that execute page JS; the form's
    // eventual backend still needs to reject this server-side too (see
    // the TODO above).
    if (honeypot?.value) {
      e.preventDefault();
      return;
    }

    if (!siteKey || hasToken) return;

    e.preventDefault();

    // If Google's script hasn't loaded (e.g. blocked in the visitor's
    // region), grecaptcha is undefined — let the submission through
    // rather than locking out a real visitor over a third-party script
    // failing to load; the honeypot and server-side checks still apply.
    if (typeof grecaptcha === "undefined") {
      form?.submit();
      return;
    }

    grecaptcha.ready(() => {
      grecaptcha
        .execute(siteKey, { action: "contact" })
        .then((token) => {
          if (tokenField) tokenField.value = token;
          hasToken = true;
          form?.requestSubmit();
        })
        .catch(() => {
          // Same reasoning as the script-blocked case above: don't lock a
          // real visitor out over a failed background token fetch.
          form?.submit();
        });
    });
  });
</script>
