---
import BaseLayout from "../layouts/BaseLayout.astro";

// Set PUBLIC_RECAPTCHA_SITE_KEY (see .env.example) to turn on the
// reCAPTCHA widget below. Left unset, the form just renders without it
// (still protected by the honeypot alone) rather than shipping a widget
// pointed at a fake key, which Google would render as a visible error
// for every visitor.
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<BaseLayout title="Contact" description="Get in touch — placeholder contact form.">
  <section class="container contact">
    <h1>Contact</h1>
    <p>
      Thank you for your interest in working together. Please share a few
      details about your project below, and I will follow up promptly to
      discuss how we might collaborate.
    </p>

    <!-- Submits to Formspree (https://formspree.io) via fetch (see the
         script below) rather than a plain form POST, so we can show an
         inline success/error message instead of navigating to Formspree's
         own confirmation page. Formspree recognizes a field literally
         named `_gotcha` as a honeypot and silently discards (200s without
         emailing) any submission where it's non-empty — see the label
         below — so that check now applies even to a bot that skips our
         page JS and posts straight to the endpoint. The reCAPTCHA token
         isn't independently verified by Formspree (their built-in
         reCAPTCHA support targets v2), so it's a client-side deterrent
         only for now. -->
    <form
      class="contact__form"
      action="https://formspree.io/f/xnpnbrgd"
      method="post"
      data-recaptcha-site-key={recaptchaSiteKey}
    >
      <label>
        Name
        <input type="text" name="name" required />
      </label>
      <label>
        Email
        <input type="email" name="email" required />
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required></textarea>
      </label>
      <!-- Honeypot: hidden from sighted users (off-screen) and screen
           readers (aria-hidden + removed from tab order), but present in
           the raw HTML for simple bots that fill in every field to find
           and fill. A human never sees or reaches it, so any submission
           with this non-empty is spam. Named `_gotcha` so Formspree
           itself enforces this, not just our page JS. -->
      <label class="contact__hp" aria-hidden="true">
        Company
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>
      {
        recaptchaSiteKey && (
          <input type="hidden" name="g-recaptcha-response" />
        )
      }
      <button type="submit">Send</button>
      <p class="contact__status" role="status" aria-live="polite" hidden></p>
    </form>
  </section>

  {
    recaptchaSiteKey && (
      <script
        is:inline
        src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}
        async
        defer
      />
    )
  }
</BaseLayout>

<style>
  .contact {
    padding-block: var(--space-5);
    max-width: 560px;
  }

  .contact h1 {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .contact__form {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .contact__form label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .contact__form input,
  .contact__form textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: #fff;
    color: var(--color-text);
  }

  .contact__form button {
    justify-self: start;
    margin-top: var(--space-1);
    padding: 0.6rem 1.5rem;
    border: 1px solid var(--color-text);
    background: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .contact__form button:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  /* Off-screen rather than display:none/visibility:hidden — some spam
     bots specifically skip fields hidden that way, which would defeat
     the honeypot. This must NOT reuse a generic .visually-hidden
     utility: that pattern intentionally stays in the accessibility
     tree for screen readers, which would expose this field to (and
     risk being filled in by) real assistive-tech users. */
  .contact__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact__status {
    margin: 0;
    font-size: 0.85rem;
  }

  .contact__status[data-state="error"] {
    color: var(--color-accent);
  }
</style>

<script>
  declare const grecaptcha:
    | {
        ready(callback: () => void): void;
        execute(siteKey: string, options: { action: string }): Promise<string>;
      }
    | undefined;

  const form = document.querySelector<HTMLFormElement>(".contact__form");
  const honeypot = form?.querySelector<HTMLInputElement>('[name="_gotcha"]');
  const siteKey = form?.dataset.recaptchaSiteKey;
  const tokenField =
    form?.querySelector<HTMLInputElement>('[name="g-recaptcha-response"]');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const statusEl = form?.querySelector<HTMLElement>(".contact__status");

  function setStatus(state: "sending" | "success" | "error" | null) {
    if (!statusEl) return;
    if (submitButton) submitButton.disabled = state === "sending";
    if (!state) {
      statusEl.hidden = true;
      return;
    }
    statusEl.hidden = false;
    statusEl.dataset.state = state;
    statusEl.textContent =
      state === "sending"
        ? "Sending…"
        : state === "success"
          ? "Thanks — I'll be in touch soon."
          : "Something went wrong sending that. Please try again, or email me directly.";
  }

  async function send() {
    if (!form) return;
    setStatus("sending");
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        setStatus("success");
        form.reset();
      } else {
        setStatus("error");
      }
    } catch {
      setStatus("error");
    }
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    // A human never sees or fills this field, so a non-empty value means a
    // bot filled in every input it could find. Formspree also enforces
    // this server-side (the field is named `_gotcha`), but skip the
    // network request entirely for a bot that runs our page JS too.
    if (honeypot?.value) return;

    if (!siteKey || typeof grecaptcha === "undefined") {
      // No widget configured, or Google's script failed to load (e.g.
      // blocked in the visitor's region) — send without a token rather
      // than locking out a real visitor over it.
      void send();
      return;
    }

    grecaptcha.ready(() => {
      grecaptcha
        .execute(siteKey, { action: "contact" })
        .then((token) => {
          if (tokenField) tokenField.value = token;
          void send();
        })
        .catch(() => {
          // Same reasoning as above: don't block a real submission over a
          // failed background token fetch.
          void send();
        });
    });
  });
</script>
