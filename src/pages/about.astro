---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import headshot from "../assets/about-headshot.jpg";
---

<BaseLayout title="About" description="About the photographer — placeholder bio, replace with real copy.">
  <section class="container about">
    <Image class="about__headshot" src={headshot} alt="Abner Soto" width={480} />
    <div class="about__copy">
      <h1>About</h1>
      <p>
        Placeholder bio. Replace with a short paragraph about your
        background, specialty, and approach to photography — the kind of
        thing a client skims before deciding to reach out.
      </p>
      <p>
        Placeholder second paragraph — equipment, location, availability, or
        whatever else belongs on this page.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: 320px 1fr;
      align-items: start;
    }
  }

  .about__headshot {
    border-radius: 4px;
  }

  .about h1 {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .about__copy p + p {
    margin-top: var(--space-2);
  }
</style>
