---
import { Image } from "astro:assets";
import type { GalleryEntry } from "../lib/galleryMedia";
import { isVideo, toSlide } from "../lib/galleryMedia";

interface Props {
  entry: GalleryEntry;
  index: number;
}

const { entry, index } = Astro.props;
const { title, alt } = entry.data;
const video = isVideo(entry);

// The slide this card's lightbox trigger opens: a larger render of the
// same photo, or the video's id (Lightbox embeds the actual player).
const slide = await toSlide(entry);
---

<button
  type="button"
  class="gallery-card"
  data-lightbox-trigger
  data-index={index}
  data-alt={alt}
  data-caption={title}
  data-full-src={slide.src}
  data-vimeo-id={slide.vimeoId}
  data-thumbnail={slide.thumbnail}
  aria-label={video ? `Play ${title}` : `View ${title} full size`}
>
  {
    video ? (
      <span class="gallery-card__video">
        <img src={entry.data.thumbnail} alt={alt} loading="lazy" />
        <span class="gallery-card__play" aria-hidden="true">
          ▶
        </span>
      </span>
    ) : (
      <Image src={entry.data.image!} alt={alt} width={700} loading="lazy" />
    )
  }
</button>

<style>
  .gallery-card {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .gallery-card :global(img) {
    width: 100%;
    height: auto;
    transition: opacity 0.2s ease;
  }

  .gallery-card:hover :global(img) {
    opacity: 0.85;
  }

  .gallery-card__video {
    position: relative;
    display: block;
  }

  .gallery-card__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }
</style>
