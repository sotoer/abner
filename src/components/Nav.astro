---
import { withBase } from "../lib/url";
import LogoHorizontal from "../assets/logo-horizontal.svg";
import LogoMark from "../assets/logo-mark.svg";

const links = [
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---

<header class="site-nav">
  <div class="container site-nav__inner">
    <a href={withBase("/")} class="site-nav__logo" aria-label="Abner Soto, home">
      <LogoHorizontal class="site-nav__logo-full" aria-hidden="true" />
      <LogoMark class="site-nav__logo-mark" aria-hidden="true" />
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={withBase(link.href)}
                aria-current={
                  currentPath.startsWith(withBase(link.href))
                    ? "page"
                    : undefined
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .site-nav__logo {
    display: flex;
    align-items: center;
    color: var(--color-text);
  }

  .site-nav__logo svg {
    display: block;
    height: 2.75rem;
    width: auto;
  }

  /* Below ~480px the full lockup crowds the nav links; show the monogram. */
  .site-nav__logo-mark {
    display: none !important;
  }

  @media (max-width: 479px) {
    .site-nav__logo-full {
      display: none !important;
    }

    .site-nav__logo-mark {
      display: block !important;
    }
  }

  nav ul {
    display: flex;
    gap: var(--space-3);
  }

  nav a {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-accent);
  }
</style>
