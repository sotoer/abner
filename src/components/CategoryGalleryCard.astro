---
import type { CategoryCard } from "../lib/categoryCards";
import { getAspectRatio, toSlide, toThumb } from "../lib/galleryMedia";

interface Props {
  category: CategoryCard;
  // Which of this category's (up to 3) tiles to render. The homepage
  // renders one tileIndex at a time across all categories, then the
  // next, so tiles from different categories interleave in the mosaic's
  // DOM order instead of each category's tiles landing in one solid
  // block (which visually clustered categories together, since earlier
  // DOM order lands higher up in the packed layout).
  tileIndex: number;
}

const { category, tileIndex } = Astro.props;

// Full-size (or video-id) slides for the lightbox — clicking any of this
// category's mosaic tiles opens the whole gallery, not just whatever
// photo/video the tile happens to be showing at that moment.
const slides = await Promise.all(category.entries.map(toSlide));
const slidesJson = JSON.stringify(slides);

// Thumbnail-sized renders of every entry in the category, each carrying
// its own aspect ratio. Each of the three tiles below cycles through
// these client-side (see <script> at the bottom) rather than being
// locked to one photo per tile — and the client-side masonry layout
// resizes/repositions a tile to match whichever one it's currently
// showing, so the ratio needs to travel with the thumbnail.
const thumbs = await Promise.all(
  category.entries.map((entry) => toThumb(entry, 700)),
);
const thumbsJson = JSON.stringify(thumbs);

// This tile's seed: (up to) three different entries per category so the
// mosaic isn't identical boxes before client JS randomizes them on load.
// The inline aspect-ratio below is only the pre-JS fallback (and the
// starting point for the layout script) — client JS resizes the tile as
// its cycling swaps in photos of other shapes. A category with fewer
// than 3 entries simply renders fewer tiles (seed is null past its count).
const seedCount = Math.min(3, thumbs.length);
const seed =
  tileIndex < seedCount
    ? {
        thumb: thumbs[tileIndex % thumbs.length],
        ...getAspectRatio(category.entries[tileIndex % category.entries.length]),
      }
    : null;
---

{
  seed && (
    <button
      type="button"
      class="category-mosaic-card"
      data-lightbox-trigger
      data-slides={slidesJson}
      data-cycle-pool={thumbsJson}
      data-cycle-group={category.slug}
      data-aspect-w={seed.width}
      data-aspect-h={seed.height}
      aria-label={`View the ${category.label} gallery`}
      style={`aspect-ratio: ${seed.width} / ${seed.height};`}
    >
      <img
        class="category-mosaic-card__img is-active"
        src={seed.thumb.src}
        alt={seed.thumb.alt}
        loading="lazy"
      />
      <img class="category-mosaic-card__img" alt="" />
    </button>
  )
}

<style>
  .category-mosaic-card {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    overflow: hidden;
  }

  /* Once the layout script measures the page and takes over (see
     initMasonryLayout below), tiles are pulled out of the normal
     column flow and placed/sized by JS instead, so their position and
     size can be animated as cycling swaps in photos of other shapes. */
  :global(.masonry.is-animated-mosaic) .category-mosaic-card {
    position: absolute;
    top: 0;
    left: 0;
    transition:
      transform 0.6s ease,
      width 0.6s ease,
      height 0.6s ease;
  }

  .category-mosaic-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1.4s ease,
      transform 6s ease-out;
  }

  .category-mosaic-card__img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .category-mosaic-card:hover .category-mosaic-card__img.is-active {
    opacity: 0.85;
  }
</style>

<script>
  interface Thumb {
    src: string;
    alt: string;
    width: number;
    height: number;
  }

  function shuffle<T>(items: T[]): T[] {
    const shuffled = items.slice();
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  // Every image should stay up for at least this long before it's cycled
  // out. Transitions are serialized (one tile at a time — see
  // initMosaicCycling), so the tick interval is derived from this and the
  // actual tile count, rather than a fixed tick that would only happen to
  // honor this minimum for one particular number of tiles.
  const MIN_DISPLAY_MS = 20000;

  interface TileState {
    el: HTMLElement;
    layers: HTMLImageElement[];
    active: HTMLImageElement;
    current: Thumb | null;
  }

  // A category's tiles share one photo pool and coordinate their picks so
  // no two of them ever display the same photo at once (different
  // categories draw from disjoint pools, so that's the only place
  // duplicates could happen).
  function createGroup(tiles: HTMLElement[]): Array<() => void> {
    const raw = tiles[0]?.dataset.cyclePool;
    if (!raw) return [];

    let pool: Thumb[];
    try {
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed) || parsed.length === 0) return [];
      pool = parsed;
    } catch {
      return [];
    }

    const states = tiles
      .map((tile): TileState | null => {
        const layers = Array.from(
          tile.querySelectorAll<HTMLImageElement>(".category-mosaic-card__img"),
        );
        if (layers.length < 2) return null;
        const active =
          layers.find((img) => img.classList.contains("is-active")) ?? layers[0];
        return { el: tile, layers, active, current: null };
      })
      .filter((state): state is TileState => state !== null);
    if (states.length === 0) return [];

    let queue = shuffle(pool);

    // Pull the next photo not currently shown by one of this tile's
    // siblings, cycling the queue (and reshuffling once exhausted) until
    // one is found.
    function draw(excluding: Set<string>): Thumb {
      for (let attempts = 0; attempts < pool.length * 2; attempts++) {
        if (queue.length === 0) queue = shuffle(pool);
        const candidate = queue.shift()!;
        if (!excluding.has(candidate.src)) return candidate;
        queue.push(candidate);
      }
      // Only reachable if the pool is smaller than the tile group itself.
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function advance(index: number, instant: boolean) {
      const state = states[index];
      // Exclude every tile's current photo in this group, including this
      // tile's own — otherwise a draw can hand a tile back the same photo
      // it's already showing, which "transitions" to an identical image.
      const excluding = new Set(
        states
          .map((s) => s.current?.src)
          .filter((src): src is string => !!src),
      );
      const thumb = draw(excluding);
      state.current = thumb;

      // Update the tile's own aspect ratio to match, and let the masonry
      // layout know it needs to resize/reposition this tile (and
      // whatever else that bumps into) to fit.
      state.el.dataset.aspectW = String(thumb.width);
      state.el.dataset.aspectH = String(thumb.height);
      state.el.dispatchEvent(
        new CustomEvent("mosaic:aspect-change", { bubbles: true }),
      );

      const nextLayer = state.layers.find((img) => img !== state.active)!;
      nextLayer.src = thumb.src;
      nextLayer.alt = thumb.alt;

      if (instant) {
        state.layers.forEach((img) => img.classList.remove("is-active"));
        nextLayer.classList.add("is-active");
        state.active = nextLayer;
        return;
      }

      // Give the browser a frame to paint the new src before crossfading
      // to it, so the transition actually has something to animate from.
      requestAnimationFrame(() => {
        state.active.classList.remove("is-active");
        nextLayer.classList.add("is-active");
        state.active = nextLayer;
      });
    }

    // Seed every tile with a distinct random photo immediately, rather
    // than leaving the server-rendered seeds up.
    states.forEach((_, i) => advance(i, true));

    return states.map((_, i) => () => advance(i, false));
  }

  function initMosaicCycling() {
    const tiles = Array.from(
      document.querySelectorAll<HTMLElement>("[data-cycle-pool]"),
    );

    const groups = new Map<string, HTMLElement[]>();
    tiles.forEach((tile) => {
      const key = tile.dataset.cycleGroup ?? tile.dataset.cyclePool ?? "";
      const group = groups.get(key);
      if (group) {
        group.push(tile);
      } else {
        groups.set(key, [tile]);
      }
    });

    const advanceFns = Array.from(groups.values()).flatMap(createGroup);
    if (advanceFns.length === 0) return;

    // Round-robin through every tile across every category, reshuffled
    // each full pass, firing one transition per tick — never more than
    // one at once. A full pass takes tickMs * advanceFns.length, which is
    // exactly how long any single tile's image stays up before its next
    // turn, so derive the tick from the tile count to guarantee the
    // minimum regardless of how many tiles end up on the page.
    const tickMs = MIN_DISPLAY_MS / advanceFns.length;
    let order = shuffle(advanceFns);
    let pos = 0;
    setInterval(() => {
      if (pos >= order.length) {
        order = shuffle(advanceFns);
        pos = 0;
      }
      order[pos++]();
    }, tickMs);
  }

  // Measures a spacing token in pixels via a throwaway probe element,
  // rather than hardcoding a px value that would drift from global.css.
  function measureSpaceToken(token: string): number {
    const probe = document.createElement("div");
    probe.style.position = "absolute";
    probe.style.visibility = "hidden";
    probe.style.width = `var(${token})`;
    document.body.appendChild(probe);
    const px = probe.getBoundingClientRect().width;
    probe.remove();
    return px || 16;
  }

  function columnsForWidth(width: number): number {
    if (width >= 1024) return 3;
    if (width >= 640) return 2;
    return 1;
  }

  // A small self-packing masonry: unlike the CSS-columns layout it
  // replaces, this positions each tile explicitly (translate + explicit
  // width/height) so that a tile resizing — because its cycling swapped
  // in a photo of a different shape — animates smoothly, and shuffles
  // every other tile's position to match rather than just growing in
  // place.
  function initMasonryLayout() {
    const containers = new Set<HTMLElement>();
    document.querySelectorAll<HTMLElement>(".category-mosaic-card").forEach((tile) => {
      const container = tile.closest<HTMLElement>(".masonry");
      if (container) containers.add(container);
    });
    if (containers.size === 0) return;

    const gapPx = measureSpaceToken("--space-2");

    function layout(container: HTMLElement) {
      const tiles = Array.from(
        container.querySelectorAll<HTMLElement>(".category-mosaic-card"),
      );
      if (tiles.length === 0) return;

      const columns = columnsForWidth(window.innerWidth);
      const colWidth = (container.clientWidth - gapPx * (columns - 1)) / columns;
      const colHeights = new Array(columns).fill(0);

      tiles.forEach((tile) => {
        const aspectW = Number(tile.dataset.aspectW) || 1;
        const aspectH = Number(tile.dataset.aspectH) || 1;
        const height = colWidth * (aspectH / aspectW);

        let col = 0;
        for (let i = 1; i < columns; i++) {
          if (colHeights[i] < colHeights[col]) col = i;
        }

        tile.style.width = `${colWidth}px`;
        tile.style.height = `${height}px`;
        tile.style.transform = `translate(${col * (colWidth + gapPx)}px, ${colHeights[col]}px)`;

        colHeights[col] += height + gapPx;
      });

      container.style.height = `${Math.max(...colHeights) - gapPx}px`;
      container.classList.add("is-animated-mosaic");
    }

    const layoutAll = () => containers.forEach(layout);
    layoutAll();

    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layoutAll, 150);
    });

    containers.forEach((container) => {
      container.addEventListener("mosaic:aspect-change", () => layout(container));
    });
  }

  function init() {
    initMosaicCycling();
    initMasonryLayout();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
