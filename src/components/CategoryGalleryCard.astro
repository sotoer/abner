---
import { getImage } from "astro:assets";
import type { CategoryCard } from "../lib/categoryCards";

interface Props {
  category: CategoryCard;
}

const { category } = Astro.props;

// Full-size renders for the lightbox — clicking any of this category's
// mosaic tiles opens the whole gallery, not just whatever photo the tile
// happens to be showing at that moment.
const slides = await Promise.all(
  category.entries.map(async (entry) => {
    const full = await getImage({ src: entry.data.image, width: 1600 });
    return { src: full.src, alt: entry.data.alt, caption: entry.data.title };
  }),
);
const slidesJson = JSON.stringify(slides);

// Thumbnail-sized renders of every photo in the category. Each of the
// three tiles below cycles through these client-side (see <script> at the
// bottom) rather than being locked to one photo per tile.
const thumbs = await Promise.all(
  category.entries.map(async (entry) => {
    const thumb = await getImage({ src: entry.data.image, width: 700 });
    return { src: thumb.src, alt: entry.data.alt };
  }),
);
const thumbsJson = JSON.stringify(thumbs);

// Three tiles, seeded with (up to) three different photos so the mosaic
// isn't three identical boxes before client JS randomizes them on load.
// Also fixes each tile's aspect ratio so the crossfade below never causes
// layout shift as it cycles through photos of other shapes.
const seedCount = Math.min(3, thumbs.length);
const tileSeeds = Array.from({ length: 3 }, (_, i) => {
  const entry = category.entries[i % category.entries.length];
  const thumb = thumbs[i % thumbs.length];
  return { thumb, width: entry.data.image.width, height: entry.data.image.height };
}).slice(0, seedCount);
---

{
  tileSeeds.map((seed) => (
    <button
      type="button"
      class="category-mosaic-card"
      data-lightbox-trigger
      data-slides={slidesJson}
      data-cycle-pool={thumbsJson}
      aria-label={`View the ${category.label} gallery`}
      style={`aspect-ratio: ${seed.width} / ${seed.height};`}
    >
      <img
        class="category-mosaic-card__img is-active"
        src={seed.thumb.src}
        alt={seed.thumb.alt}
        loading="lazy"
      />
      <img class="category-mosaic-card__img" alt="" />
    </button>
  ))
}

<style>
  .category-mosaic-card {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    overflow: hidden;
  }

  .category-mosaic-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1.4s ease,
      transform 6s ease-out;
  }

  .category-mosaic-card__img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .category-mosaic-card:hover .category-mosaic-card__img.is-active {
    opacity: 0.85;
  }
</style>

<script>
  interface Thumb {
    src: string;
    alt: string;
  }

  function shuffle<T>(items: T[]): T[] {
    const shuffled = items.slice();
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  // How often a single tile transitions. Kept as one shared, serialized
  // rotation (rather than each tile running its own independent timer) so
  // exactly one image is ever mid-transition at a time.
  const TICK_MS = 1800;

  function createTile(tile: HTMLElement): (() => void) | null {
    const raw = tile.dataset.cyclePool;
    if (!raw) return null;

    let pool: Thumb[];
    try {
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed) || parsed.length === 0) return null;
      pool = parsed;
    } catch {
      return null;
    }

    const layers = Array.from(
      tile.querySelectorAll<HTMLImageElement>(".category-mosaic-card__img"),
    );
    if (layers.length < 2) return null;

    let queue = shuffle(pool);
    let queuePos = 0;
    let activeLayer =
      layers.find((img) => img.classList.contains("is-active")) ?? layers[0];

    function advance(instant: boolean) {
      if (queuePos >= queue.length) {
        queue = shuffle(pool);
        queuePos = 0;
      }
      const thumb = queue[queuePos++];
      const nextLayer = layers.find((img) => img !== activeLayer)!;
      nextLayer.src = thumb.src;
      nextLayer.alt = thumb.alt;

      if (instant) {
        layers.forEach((img) => img.classList.remove("is-active"));
        nextLayer.classList.add("is-active");
        activeLayer = nextLayer;
        return;
      }

      // Give the browser a frame to paint the new src before crossfading
      // to it, so the transition actually has something to animate from.
      requestAnimationFrame(() => {
        activeLayer.classList.remove("is-active");
        nextLayer.classList.add("is-active");
        activeLayer = nextLayer;
      });
    }

    // Randomize the visible photo immediately rather than leaving the
    // server-rendered seed up, so every page load shows a fresh pick.
    advance(true);

    return () => advance(false);
  }

  function initMosaicCycling() {
    const tiles = Array.from(
      document.querySelectorAll<HTMLElement>("[data-cycle-pool]"),
    );

    const advanceFns = tiles
      .map(createTile)
      .filter((fn): fn is () => void => fn !== null);
    if (advanceFns.length === 0) return;

    // Round-robin through every tile, reshuffled each full pass, firing
    // one transition per tick — never more than one at once.
    let order = shuffle(advanceFns);
    let pos = 0;
    setInterval(() => {
      if (pos >= order.length) {
        order = shuffle(advanceFns);
        pos = 0;
      }
      order[pos++]();
    }, TICK_MS);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMosaicCycling);
  } else {
    initMosaicCycling();
  }
</script>
