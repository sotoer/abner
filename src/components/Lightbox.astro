---
// Overlay image viewer. Include once on any page that renders GalleryCards
// (data-lightbox-trigger elements) — it wires itself up to whatever
// triggers exist on the page at load time.
---

<div class="lightbox" id="lightbox" hidden aria-hidden="true">
  <div class="lightbox__backdrop" data-lightbox-close></div>
  <div class="lightbox__dialog" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">
      &#x2715;
    </button>
    <button type="button" class="lightbox__prev" data-lightbox-prev aria-label="Previous image">
      &#x2039;
    </button>
    <figure class="lightbox__figure">
      <img class="lightbox__image" id="lightbox-image" alt="" />
      <div class="lightbox__video-wrap" id="lightbox-video-wrap" hidden>
        <iframe
          class="lightbox__video"
          id="lightbox-video"
          title=""
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
        ></iframe>
      </div>
      <figcaption class="lightbox__caption" id="lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="lightbox__next" data-lightbox-next aria-label="Next image">
      &#x203A;
    </button>
    <ul class="lightbox__filmstrip" id="lightbox-filmstrip"></ul>
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox__dialog {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    gap: var(--space-2);
  }

  .lightbox__figure {
    margin: 0;
    max-width: min(90vw, 1400px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
  }

  .lightbox__video-wrap {
    width: min(90vw, 1400px);
    max-height: 70vh;
    aspect-ratio: 16 / 9;
  }

  .lightbox__video-wrap[hidden] {
    display: none;
  }

  .lightbox__video {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lightbox__caption {
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .lightbox__close,
  .lightbox__prev,
  .lightbox__next {
    position: absolute;
    background: none;
    border: 0;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    padding: var(--space-1);
  }

  .lightbox__close {
    top: var(--space-2);
    right: var(--space-2);
  }

  .lightbox__prev {
    left: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__next {
    right: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__filmstrip {
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    max-width: 90vw;
    padding-block: var(--space-1);
  }

  .lightbox__filmstrip img {
    height: 60px;
    width: auto;
    opacity: 0.5;
    cursor: pointer;
    border-radius: 2px;
  }

  .lightbox__filmstrip img.is-active {
    opacity: 1;
    outline: 2px solid var(--color-accent);
  }
</style>

<script>
  function initLightbox() {
    const rootRaw = document.getElementById("lightbox");
    const imageRaw = document.getElementById("lightbox-image");
    const videoWrapRaw = document.getElementById("lightbox-video-wrap");
    const videoRaw = document.getElementById("lightbox-video");
    const captionRaw = document.getElementById("lightbox-caption");
    const filmstripRaw = document.getElementById("lightbox-filmstrip");
    if (
      !(rootRaw instanceof HTMLElement) ||
      !(imageRaw instanceof HTMLImageElement) ||
      !(videoWrapRaw instanceof HTMLElement) ||
      !(videoRaw instanceof HTMLIFrameElement) ||
      !(captionRaw instanceof HTMLElement) ||
      !(filmstripRaw instanceof HTMLElement)
    ) {
      return;
    }

    // Re-bind to non-nullable typed consts so the closures below (which
    // TS otherwise re-widens to the nullable `getElementById` return type)
    // see the already-checked, precise element types.
    const root: HTMLElement = rootRaw;
    const imageEl: HTMLImageElement = imageRaw;
    const videoWrapEl: HTMLElement = videoWrapRaw;
    const videoEl: HTMLIFrameElement = videoRaw;
    const captionEl: HTMLElement = captionRaw;
    const filmstripEl: HTMLElement = filmstripRaw;

    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]"),
    );
    if (triggers.length === 0) return;

    interface Slide {
      kind: "photo" | "video";
      src?: string; // photo only
      vimeoId?: string; // video only
      thumbnail: string; // filmstrip still, either kind
      alt: string;
      caption: string;
    }

    function slideFor(el: HTMLElement): Slide {
      const vimeoId = el.dataset.vimeoId;
      if (vimeoId) {
        return {
          kind: "video",
          vimeoId,
          thumbnail: el.dataset.thumbnail || "",
          alt: el.dataset.alt || "",
          caption: el.dataset.caption || "",
        };
      }
      const src = el.dataset.fullSrc || "";
      return {
        kind: "photo",
        src,
        thumbnail: el.dataset.thumbnail || src,
        alt: el.dataset.alt || "",
        caption: el.dataset.caption || "",
      };
    }

    // A trigger normally contributes exactly one slide, and every such
    // trigger on the page shares one page-wide, browsable set (e.g. each
    // photo on a category gallery page). A trigger can instead carry
    // data-slides — a JSON array of slides — to open its own
    // self-contained set scoped to just that trigger (e.g. a homepage
    // category tile opening that category's whole gallery, without
    // spilling into the other categories' tiles alongside it).
    function groupFor(el: HTMLElement): Slide[] | null {
      const raw = el.dataset.slides;
      if (!raw) return null;
      try {
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : null;
      } catch {
        return null;
      }
    }

    const pageSlides = triggers.filter((el) => !groupFor(el)).map(slideFor);

    let activeSlides: Slide[] = [];
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function renderFilmstrip() {
      filmstripEl.innerHTML = "";
      activeSlides.forEach((slide, i) => {
        const li = document.createElement("li");
        const img = document.createElement("img");
        img.src = slide.thumbnail;
        img.alt = "";
        img.className = i === currentIndex ? "is-active" : "";
        li.appendChild(img);
        li.addEventListener("click", () => show(i));
        filmstripEl.appendChild(li);
      });
    }

    function show(index: number) {
      currentIndex = (index + activeSlides.length) % activeSlides.length;
      const slide = activeSlides[currentIndex];
      captionEl.textContent = slide.caption;

      if (slide.kind === "video") {
        imageEl.hidden = true;
        videoWrapEl.hidden = false;
        videoEl.src = `https://player.vimeo.com/video/${slide.vimeoId}`;
        videoEl.title = slide.caption;
      } else {
        // Clearing the iframe's src (rather than just hiding it) stops
        // playback — otherwise a video keeps running, audibly, behind
        // whatever photo you navigate to next.
        videoEl.src = "";
        videoWrapEl.hidden = true;
        imageEl.hidden = false;
        imageEl.src = slide.src || "";
        imageEl.alt = slide.alt;
      }

      renderFilmstrip();
    }

    function open(slides: Slide[], index: number) {
      activeSlides = slides;
      lastFocused = document.activeElement as HTMLElement | null;
      show(index);
      root.hidden = false;
      root.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      root.querySelector<HTMLElement>("[data-lightbox-close]")?.focus();
    }

    function close() {
      videoEl.src = ""; // stop playback rather than leaving it running hidden
      root.hidden = true;
      root.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      lastFocused?.focus();
    }

    let pageSlideIndex = 0;
    triggers.forEach((el) => {
      const group = groupFor(el);
      if (group) {
        el.addEventListener("click", () => open(group, 0));
      } else {
        const index = pageSlideIndex++;
        el.addEventListener("click", () => open(pageSlides, index));
      }
    });

    root.querySelectorAll("[data-lightbox-close]").forEach((el) => {
      el.addEventListener("click", close);
    });
    root
      .querySelector("[data-lightbox-prev]")
      ?.addEventListener("click", () => show(currentIndex - 1));
    root
      .querySelector("[data-lightbox-next]")
      ?.addEventListener("click", () => show(currentIndex + 1));

    document.addEventListener("keydown", (e) => {
      if (root.hidden) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") show(currentIndex - 1);
      if (e.key === "ArrowRight") show(currentIndex + 1);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLightbox);
  } else {
    initLightbox();
  }
</script>
