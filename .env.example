# Copy to .env and fill in to enable the contact form's reCAPTCHA check
# (src/pages/contact.astro). Without it, the form still works — it just
# relies on the honeypot field alone.
#
# Must be a reCAPTCHA v3 site key (invisible, score-based) — a v2 key
# renders Google's "Invalid key type" error instead. Register one at:
# https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=

# Copy to .env and fill in to enable Google Analytics (src/layouts/
# BaseLayout.astro). Without it, no analytics script loads at all.
#
# Create a GA4 property (or reuse one) and grab its Measurement ID at:
# https://analytics.google.com — it looks like "G-XXXXXXXXXX".
PUBLIC_GA_MEASUREMENT_ID=
